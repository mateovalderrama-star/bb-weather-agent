# OpenAI / FuelIX Configuration
OPENAI_API_KEY=your_fuelix_api_key_here

# GCP Configuration (used for IAM auth with Cloud SQL)
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/YourUsername/AppData/Roaming/gcloud/application_default_credentials.json
GCP_PROJECT_ID=your-gcp-project-id

# Cloud SQL Configuration
# Format: project-id:region:instance-name
CLOUD_SQL_INSTANCE_CONNECTION_NAME=your-project:us-central1:your-instance
CLOUD_SQL_DATABASE=your_database_name
# For IAM auth leave CLOUD_SQL_USER as service account email and CLOUD_SQL_PASSWORD empty
CLOUD_SQL_USER=service-account@your-project.iam.gserviceaccount.com
CLOUD_SQL_PASSWORD=
CLOUD_SQL_USE_IAM_AUTH=true

# Proxy Configuration (if needed — Telus corporate network)
HTTP_PROXY=http://198.161.14.25:8080
HTTPS_PROXY=http://198.161.14.25:8080
NO_PROXY=localhost,127.0.0.1

# Agent Configuration
LOG_LEVEL=INFO
MAX_QUERY_RESULTS=1000
OPENAI_MODEL=claude-sonnet-4-5
TEMPERATURE=0.1

